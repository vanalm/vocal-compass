{
  "name": "vocal-compass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first melodic navigation trainer: train the destination, not just the landing.",
  "scripts": {
    "dev": "vite",
    "api": "cd server && .venv/bin/uvicorn --factory vocal_compass.app:create_app --reload --port 8799",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pitchy": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
