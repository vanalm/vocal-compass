# Vocal Compass server configuration. Development needs none of it; staging and production need
# DATABASE_URL and the WORKOS_* values. Empty values count as unset. The server reads its process
# environment only: export these, or run `uvicorn --env-file .env ...`.

# development | test | staging | production
ENVIRONMENT=development

# The origin browsers use, with no trailing slash. The OAuth redirect is {APP_BASE_URL}/api/auth/callback,
# state-changing /api requests must come from this origin, and https turns on Secure __Host- cookies and HSTS.
APP_BASE_URL=http://localhost:5199

# Required in staging and production; sqlite:///./dev.db in development and test.
# Cloud SQL: postgresql+psycopg://vocal:PASSWORD@/vocal?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# dev (one fixed local user, refused in staging and production) or workos.
# Defaults to dev in development and test, workos elsewhere.
AUTH_MODE=

# WorkOS AuthKit, required when AUTH_MODE=workos.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# A Fernet key (the SDK seals sessions with Fernet):
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
WORKOS_COOKIE_PASSWORD=

# Signs dev-auth session cookies. Defaults to a public development constant.
SESSION_SECRET=

# Who may sign in: comma-separated emails and @domain entries. Empty lets anyone sign up.
AUTH_ALLOWED_EMAILS=

# text (the default in development) or json (the default elsewhere: Cloud Logging's structured format).
LOG_FORMAT=
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Set on Cloud Run to tie log lines to request traces.
GOOGLE_CLOUD_PROJECT=

# A built SPA (a directory holding index.html) to serve beside /api. The container sets /app/web.
SPA_DIST_DIR=

# Reported by /api/health and on every log line; the image bakes in its git SHA.
RELEASE=dev

# How many proxies in front of the app append to X-Forwarded-For, where rate limits read the client IP:
# 0 trusts only the connection's peer, 1 is Cloud Run on its run.app URL, 2 the load balancer in front of it.
TRUSTED_PROXY_HOPS=0

# 0 or 1. With 1, entrypoint.sh runs `alembic upgrade head` before starting the server, and exits if it
# fails. The development server migrates its own database on startup either way.
RUN_MIGRATIONS_ON_START=0
